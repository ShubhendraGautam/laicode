{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/implementation-manifest.v0.schema.json",
  "title": "LAIcode implementation manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "runtime_version",
    "dependency_profile",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "ImplementationManifestV0" },
    "runtime": { "const": "python" },
    "runtime_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "dependency_profile": { "const": "stdlib_only" },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(laicode/[a-z_]+[.]py|schemas/[a-z0-9.-]+[.]schema[.]json)$"
      },
      "additionalProperties": { "$ref": "#/$defs/content_id" }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
