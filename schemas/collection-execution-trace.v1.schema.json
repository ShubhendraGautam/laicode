{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/collection-execution-trace.v1.schema.json",
  "title": "Collection-language execution trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "cycle", "case_id", "events", "truncated"],
  "properties": {
    "schema_version": { "const": "CollectionExecutionTraceV1" },
    "task_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" },
    "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
    "case_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
    "events": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/event" } },
    "truncated": { "type": "boolean" }
  },
  "$defs": {
    "event": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["event", "name", "capacity"],
          "properties": { "event": { "const": "own_vector" }, "name": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" }, "capacity": { "type": "integer", "minimum": 0, "maximum": 256 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["event", "name"],
          "properties": { "event": { "enum": ["let", "assign"] }, "name": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["event", "vector", "length"],
          "properties": { "event": { "const": "push" }, "vector": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" }, "length": { "type": "integer", "minimum": 1, "maximum": 256 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["event", "entry_id", "kind", "length"],
          "properties": {
            "event": { "const": "intrinsic" }, "entry_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
            "kind": { "enum": ["push_indexed", "append_indexed_if"] }, "length": { "type": "integer", "minimum": 0, "maximum": 256 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["event", "fields"],
          "properties": { "event": { "const": "return" }, "fields": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" } } }
        }
      ]
    }
  }
}
