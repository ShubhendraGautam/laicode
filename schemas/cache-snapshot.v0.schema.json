{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-snapshot.v0.schema.json",
  "title": "LAIcode immutable cache policy snapshot v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "capacity",
    "requested_key",
    "entries",
    "evictable_keys",
    "pinned_keys"
  ],
  "properties": {
    "schema_version": { "const": "CacheSnapshotV0" },
    "sequence": { "$ref": "#/$defs/nonnegative" },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "requested_key": { "$ref": "#/$defs/key" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/entry" }
    },
    "evictable_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "pinned_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    }
  },
  "$defs": {
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "inserted_at", "last_access", "frequency"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "inserted_at": { "$ref": "#/$defs/nonnegative" },
        "last_access": { "$ref": "#/$defs/nonnegative" },
        "frequency": { "$ref": "#/$defs/positive" }
      }
    }
  },
  "$comment": "The trusted simulator enforces unique sorted entry keys, partition of resident keys into pinned/evictable sets, time ordering, and a non-empty evictable domain before invoking a policy."
}
