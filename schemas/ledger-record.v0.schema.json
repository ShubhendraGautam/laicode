{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/ledger-record.v0.schema.json",
  "title": "LAIcode append-only ledger record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event"],
  "properties": {
    "schema_version": { "const": "LedgerRecordV0" },
    "event_id": { "$ref": "#/$defs/content_id" },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sequence",
        "previous_event_id",
        "event_type",
        "candidate_id",
        "artifact_id",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": "LedgerEventV0" },
        "sequence": { "$ref": "#/$defs/nonnegative" },
        "previous_event_id": { "$ref": "#/$defs/nullable_content_id" },
        "event_type": {
          "enum": [
            "run_started",
            "manifest_frozen",
            "evaluator_validated",
            "candidate_proposed",
            "candidate_built",
            "candidate_verified",
            "search_evaluated",
            "operationally_evaluated",
            "historically_evaluated",
            "candidate_eligible",
            "candidate_rejected",
            "offline_champion_selected",
            "decision_frozen",
            "prospective_evaluated",
            "research_audit_consumed",
            "run_completed",
            "incident"
          ]
        },
        "candidate_id": { "$ref": "#/$defs/nullable_content_id" },
        "artifact_id": { "$ref": "#/$defs/nullable_content_id" },
        "payload": { "type": "object" }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_content_id": {
      "oneOf": [
        { "$ref": "#/$defs/content_id" },
        { "type": "null" }
      ]
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "$comment": "The ledger decoder additionally enforces canonical JSONL, contiguous sequence numbers, previous-event chaining, event content identity, file locking, and a caller-pinned final event."
}
