{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/evaluator-meta-test-report.v0.schema.json",
  "title": "LAIcode evaluator meta-test report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_version",
    "passed",
    "checks",
    "evidence_result_ids",
    "evaluator_queries"
  ],
  "properties": {
    "schema_version": { "const": "EvaluatorMetaTestReportV0" },
    "suite_version": { "const": "CacheEvaluatorMetaSuiteV0" },
    "passed": { "const": true },
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed"],
        "properties": {
          "id": {
            "enum": [
              "exact_replay",
              "known_scan_improvement_direction",
              "known_shift_regression_direction",
              "invalid_output_shielded",
              "policy_error_shielded",
              "empty_domain_not_invoked",
              "metric_denominators_complete",
              "no_unshielded_test_violation"
            ]
          },
          "passed": { "const": true }
        }
      }
    },
    "evidence_result_ids": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "evaluator_queries": { "const": 8 }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
