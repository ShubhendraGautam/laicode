{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/function-language-run-report-record.v2.schema.json",
  "title": "Function-language run report record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report"],
  "properties": {
    "schema_version": { "const": "FunctionLanguageRunReportRecordV2" },
    "report_id": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "experiment_manifest_id", "task_count", "case_count", "cycle_count", "final_vocabulary_id", "cycle_results", "platform_style_transfer", "unlearned_local_functions", "maximum_static_call_depth", "all_valid", "validity_scope", "generated_c_sources", "native_validation_required_for_compiled_claim", "official_platform_submission_performed", "limitations"],
      "properties": {
        "schema_version": { "const": "FunctionLanguageRunReportV2" },
        "status": { "const": "complete" },
        "experiment_manifest_id": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" },
        "task_count": { "const": 7 }, "case_count": { "const": 224 }, "cycle_count": { "const": 3 },
        "final_vocabulary_id": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" },
        "cycle_results": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/cycle" } },
        "platform_style_transfer": {
          "type": "object", "additionalProperties": false,
          "required": ["highest_altitude", "sum_absolute_deviation", "max_increasing_difference"],
          "properties": {
            "highest_altitude": { "$ref": "#/$defs/transfer" },
            "sum_absolute_deviation": { "$ref": "#/$defs/transfer" },
            "max_increasing_difference": { "$ref": "#/$defs/transfer" }
          }
        },
        "unlearned_local_functions": { "const": ["max_absolute_pair", "min_of"] },
        "maximum_static_call_depth": { "type": "integer", "minimum": 1, "maximum": 4 },
        "all_valid": { "const": true }, "validity_scope": { "const": "trusted_interpreter_all_cycles" },
        "generated_c_sources": { "const": 21 }, "native_validation_required_for_compiled_claim": { "const": true },
        "official_platform_submission_performed": { "const": false },
        "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "cycle": {
      "type": "object", "additionalProperties": false,
      "required": ["cycle", "vocabulary_id", "entry_count", "new_entry_id", "cases_passed", "total_dispatches", "total_definition_statements"],
      "properties": {
        "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
        "vocabulary_id": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" },
        "entry_count": { "type": "integer", "minimum": 0, "maximum": 2 },
        "new_entry_id": { "oneOf": [{ "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" }, { "type": "null" }] },
        "cases_passed": { "const": 224 },
        "total_dispatches": { "type": "integer", "minimum": 1 },
        "total_definition_statements": { "type": "integer", "minimum": 0 }
      }
    },
    "transfer": {
      "type": "object", "additionalProperties": false,
      "required": ["partition", "cycle_0_definition_statements", "cycle_2_definition_statements", "definition_statement_reduction", "cycle_0_dispatches", "cycle_2_dispatches", "dispatch_change", "learned_entry_ids", "all_cycles_valid"],
      "properties": {
        "partition": { "enum": ["protected_holdout", "postfreeze_audit"] },
        "cycle_0_definition_statements": { "type": "integer", "minimum": 0 },
        "cycle_2_definition_statements": { "type": "integer", "minimum": 0 },
        "definition_statement_reduction": { "type": "integer", "minimum": 1 },
        "cycle_0_dispatches": { "type": "integer", "minimum": 1 },
        "cycle_2_dispatches": { "type": "integer", "minimum": 1 },
        "dispatch_change": { "const": 0 },
        "learned_entry_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" } },
        "all_cycles_valid": { "const": true }
      }
    }
  },
  "$comment": "dispatch_change is constrained to zero because an A2 learned abstraction must remove duplicated definitions without altering executed work."
}
