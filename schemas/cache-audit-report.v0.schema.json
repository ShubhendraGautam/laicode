{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-audit-report.v0.schema.json",
  "title": "LAIcode post-decision research audit report v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frozen_decision_id", "evaluations"],
  "properties": {
    "schema_version": { "const": "CacheAuditReportV0" },
    "frozen_decision_id": { "$ref": "#/$defs/content_id" },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "cache-partition-evaluation.v0.schema.json" }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$comment": "The evidence manager enforces one-shot consumption after the referenced offline decision is frozen; audit evidence never enters that decision."
}
