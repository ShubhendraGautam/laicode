{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-policy-action.v0.schema.json",
  "title": "LAIcode cache-policy construction action v0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action", "payload"],
      "properties": {
        "schema_version": { "const": "CachePolicyActionV0" },
        "action": { "const": "fill_hole" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hole_id", "constructor"],
          "properties": {
            "hole_id": { "const": "root" },
            "constructor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["op", "strategy_id"],
              "properties": {
                "op": { "const": "select_strategy" },
                "strategy_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action", "payload"],
      "properties": {
        "schema_version": { "const": "CachePolicyActionV0" },
        "action": { "const": "abandon_branch" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        }
      }
    }
  ],
  "$comment": "Contract authorization, open-hole identity, type/effect preservation, and state transition checks are enforced by laicode.kernel."
}
