{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/machine-experiment-run-report-record.v0.schema.json",
  "title": "Machine-language experiment run report record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report"],
  "properties": {
    "schema_version": { "const": "MachineExperimentRunReportRecordV0" },
    "report_id": { "$ref": "#/$defs/content_id" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "claim_level",
        "implementation_id",
        "experiment_manifest_id",
        "evidence_catalog_id",
        "archived_evidence_catalog_id",
        "offline_decision_id",
        "audit_report_id",
        "selected_variant",
        "learned_vocabulary_id",
        "vocabulary_ids_by_variant",
        "operational_total_units",
        "audit_total_units",
        "future_total_units",
        "central_hypothesis_passed",
        "persistent_vocabulary_changed_next_proposal",
        "matched_nonprimitive_entry_count",
        "matched_nonprimitive_lowering_lengths",
        "future_negative_transfer_retained",
        "research_audit_used_for_selection",
        "deployment_performed",
        "exact_replay_supported",
        "host_hardware_measurement_included",
        "limitations"
      ],
      "properties": {
        "schema_version": { "const": "MachineExperimentRunReportV0" },
        "status": { "const": "complete" },
        "claim_level": { "const": "exploratory_transparent_vocabulary_evolution_only" },
        "implementation_id": { "$ref": "#/$defs/content_id" },
        "experiment_manifest_id": { "$ref": "#/$defs/content_id" },
        "evidence_catalog_id": { "$ref": "#/$defs/content_id" },
        "archived_evidence_catalog_id": { "$ref": "#/$defs/content_id" },
        "offline_decision_id": { "$ref": "#/$defs/content_id" },
        "audit_report_id": { "$ref": "#/$defs/content_id" },
        "selected_variant": { "$ref": "#/$defs/variant" },
        "learned_vocabulary_id": { "$ref": "#/$defs/content_id" },
        "vocabulary_ids_by_variant": { "$ref": "#/$defs/variant_ids" },
        "operational_total_units": { "$ref": "#/$defs/variant_costs" },
        "audit_total_units": { "$ref": "#/$defs/variant_costs" },
        "future_total_units": { "$ref": "#/$defs/variant_costs" },
        "central_hypothesis_passed": { "type": "boolean" },
        "persistent_vocabulary_changed_next_proposal": { "type": "boolean" },
        "matched_nonprimitive_entry_count": { "type": "integer", "minimum": 0 },
        "matched_nonprimitive_lowering_lengths": {
          "type": "array",
          "items": { "type": "integer", "minimum": 2, "maximum": 8 }
        },
        "future_negative_transfer_retained": { "type": "boolean" },
        "research_audit_used_for_selection": { "const": false },
        "deployment_performed": { "const": false },
        "exact_replay_supported": { "const": true },
        "host_hardware_measurement_included": { "const": false },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "variant": {
      "enum": ["primitive", "learned", "fixed_human", "seeded_random"]
    },
    "variant_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "learned", "fixed_human", "seeded_random"],
      "properties": {
        "primitive": { "$ref": "#/$defs/content_id" },
        "learned": { "$ref": "#/$defs/content_id" },
        "fixed_human": { "$ref": "#/$defs/content_id" },
        "seeded_random": { "$ref": "#/$defs/content_id" }
      }
    },
    "variant_costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "learned", "fixed_human", "seeded_random"],
      "properties": {
        "primitive": { "type": "integer", "minimum": 0 },
        "learned": { "type": "integer", "minimum": 0 },
        "fixed_human": { "type": "integer", "minimum": 0 },
        "seeded_random": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
