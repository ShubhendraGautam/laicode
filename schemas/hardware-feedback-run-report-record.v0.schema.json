{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/hardware-feedback-run-report-record.v0.schema.json",
  "title": "Hardware-feedback run report record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report"],
  "properties": {
    "schema_version": { "const": "HardwareFeedbackRunReportRecordV0" },
    "report_id": { "$ref": "#/$defs/content_id" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "claim_level",
        "study_manifest_id",
        "target_id",
        "aggregate_id",
        "target_profile_id",
        "lifecycle_decision_id",
        "session_report_ids",
        "session_count",
        "selected_cycles_by_pit",
        "decision_replay_supported",
        "host_timings_exactly_replayable",
        "deployment_performed",
        "limitations"
      ],
      "properties": {
        "schema_version": { "const": "HardwareFeedbackRunReportV0" },
        "status": { "const": "complete" },
        "claim_level": { "const": "exploratory_single_target_replicated_feedback_only" },
        "study_manifest_id": { "$ref": "#/$defs/content_id" },
        "target_id": { "$ref": "#/$defs/content_id" },
        "aggregate_id": { "$ref": "#/$defs/content_id" },
        "target_profile_id": { "$ref": "#/$defs/content_id" },
        "lifecycle_decision_id": { "$ref": "#/$defs/content_id" },
        "session_report_ids": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/content_id" }
        },
        "session_count": { "type": "integer", "minimum": 3 },
        "selected_cycles_by_pit": { "$ref": "#/$defs/pit_cycles" },
        "decision_replay_supported": { "const": true },
        "host_timings_exactly_replayable": { "const": false },
        "deployment_performed": { "const": false },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pit_cycles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reuse_holdout", "audit_transfer", "shift_no_reuse"],
      "properties": {
        "reuse_holdout": { "type": "integer", "minimum": 0, "maximum": 2 },
        "audit_transfer": { "type": "integer", "minimum": 0, "maximum": 2 },
        "shift_no_reuse": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    }
  }
}
