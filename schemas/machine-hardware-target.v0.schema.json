{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/machine-hardware-target.v0.schema.json",
  "title": "Pinned machine-language hardware target v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system",
    "release",
    "machine",
    "cpu_model",
    "backend",
    "compiler"
  ],
  "properties": {
    "schema_version": { "const": "MachineHardwareTargetV0" },
    "system": { "type": "string", "minLength": 1 },
    "release": { "type": "string", "minLength": 1 },
    "machine": { "type": "string", "minLength": 1 },
    "cpu_model": { "type": "string", "minLength": 1 },
    "backend": { "const": "GeneratedCVolatileSwitchInterpreterV0" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "resolved_path", "version", "flags"],
      "properties": {
        "requested": { "const": "cc" },
        "resolved_path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "flags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
