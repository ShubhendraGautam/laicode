{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-shadow-run-report-record.v0.schema.json",
  "title": "LAIcode D1 cache shadow run report record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report"],
  "properties": {
    "schema_version": { "const": "CacheShadowRunReportRecordV0" },
    "report_id": { "$ref": "#/$defs/content_id" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "claim_level",
        "implementation_id",
        "source_run_report_id",
        "contract_id",
        "lease_id",
        "trace_id",
        "champion_artifact_id",
        "challenger_artifact_id",
        "served_artifact_id",
        "champion_result_id",
        "challenger_result_id",
        "checkpoint_ids",
        "disposition",
        "observed_events",
        "revoked_at_event_count",
        "final_event_id",
        "ledger_id",
        "archived_payload_bytes_before_report",
        "challenger_served_effects",
        "deployment_performed",
        "promotion_performed",
        "last_known_good_preserved",
        "limitations"
      ],
      "properties": {
        "schema_version": { "const": "CacheShadowRunReportV0" },
        "status": { "const": "complete" },
        "claim_level": { "const": "D1_counterfactual_shadow_only" },
        "implementation_id": { "$ref": "#/$defs/content_id" },
        "source_run_report_id": { "$ref": "#/$defs/content_id" },
        "contract_id": { "$ref": "#/$defs/content_id" },
        "lease_id": { "$ref": "#/$defs/content_id" },
        "trace_id": { "$ref": "#/$defs/content_id" },
        "champion_artifact_id": { "$ref": "#/$defs/content_id" },
        "challenger_artifact_id": { "$ref": "#/$defs/content_id" },
        "served_artifact_id": { "$ref": "#/$defs/content_id" },
        "champion_result_id": { "$ref": "#/$defs/content_id" },
        "challenger_result_id": { "$ref": "#/$defs/content_id" },
        "checkpoint_ids": { "$ref": "#/$defs/content_ids" },
        "disposition": {
          "enum": [
            "revoked_hard_constraint",
            "revoked_regression",
            "lease_expired_no_promotion"
          ]
        },
        "observed_events": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "revoked_at_event_count": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 4096 },
            { "type": "null" }
          ]
        },
        "final_event_id": { "$ref": "#/$defs/content_id" },
        "ledger_id": { "$ref": "#/$defs/content_id" },
        "archived_payload_bytes_before_report": {
          "type": "integer",
          "minimum": 0
        },
        "challenger_served_effects": { "const": false },
        "deployment_performed": { "const": false },
        "promotion_performed": { "const": false },
        "last_known_good_preserved": { "const": true },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    }
  },
  "$comment": "Replay additionally checks report identity, final ledger event, lease identity, embedded source run, complete inventory, and every archived byte."
}
