{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/hardware-vocabulary-lifecycle-decision.v0.schema.json",
  "title": "Offline hardware vocabulary lifecycle decision v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_manifest_id",
    "aggregate_id",
    "target_profile_id",
    "selected_cycles_by_pit",
    "outcome",
    "selection_rule",
    "primitive_semantics_changed",
    "vocabulary_entries_deleted",
    "new_entries_generated_from_host_timing",
    "deployment_performed",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "HardwareVocabularyLifecycleDecisionV0" },
    "study_manifest_id": { "$ref": "#/$defs/content_id" },
    "aggregate_id": { "$ref": "#/$defs/content_id" },
    "target_profile_id": { "$ref": "#/$defs/content_id" },
    "selected_cycles_by_pit": { "$ref": "#/$defs/pit_cycles" },
    "outcome": { "const": "target_specific_profile_frozen_offline" },
    "selection_rule": { "const": "eligible_cycle_with_lowest_median_of_session_medians_then_cycle" },
    "primitive_semantics_changed": { "const": false },
    "vocabulary_entries_deleted": { "const": false },
    "new_entries_generated_from_host_timing": { "const": false },
    "deployment_performed": { "const": false },
    "authority": { "const": "D0_offline_only" }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pit_cycles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reuse_holdout", "audit_transfer", "shift_no_reuse"],
      "properties": {
        "reuse_holdout": { "type": "integer", "minimum": 0, "maximum": 2 },
        "audit_transfer": { "type": "integer", "minimum": 0, "maximum": 2 },
        "shift_no_reuse": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    }
  }
}
