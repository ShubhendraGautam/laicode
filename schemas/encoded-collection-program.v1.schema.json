{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/encoded-collection-program.v1.schema.json",
  "title": "LAIcode vocabulary-encoded collection program v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kernel_version", "task_id", "parameters", "return_type", "effects", "statements"],
  "properties": {
    "schema_version": { "const": "EncodedCollectionProgramV1" },
    "kernel_version": { "const": "OwnedVectorRecordKernelV1" },
    "task_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" },
    "parameters": { "const": [{ "name": "nums", "type": "array_i64" }, { "name": "target", "type": "i64" }] },
    "return_type": { "$ref": "collection-language-defs.v1.schema.json#/$defs/return_type" },
    "effects": { "const": ["bounded_local_vector_mutation"] },
    "statements": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "collection-language-defs.v1.schema.json#/$defs/statement" } }
  }
}
