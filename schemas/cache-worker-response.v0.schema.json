{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-worker-response.v0.schema.json",
  "title": "LAIcode isolated cache worker response v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "result"],
  "properties": {
    "schema_version": { "const": "CacheWorkerResponseV0" },
    "result_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result": { "$ref": "cache-simulation-result.v0.schema.json" }
  },
  "$comment": "The supervisor verifies the result hash and byte-compares the response with an independent in-process reference execution."
}
