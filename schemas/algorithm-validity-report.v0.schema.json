{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/algorithm-validity-report.v0.schema.json",
  "title": "Algorithm interpreter validity report v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "partition", "cycle", "core_program_id", "encoded_program_id", "vocabulary_id", "intrinsic_entry_ids", "intrinsic_static_uses", "cases_passed", "cases_total", "all_outputs_match_oracle", "total_dispatches", "total_steps", "case_results"],
  "properties": {
    "schema_version": { "const": "AlgorithmValidityReportV0" },
    "task_id": { "$ref": "algorithm-program.v0.schema.json#/$defs/identifier" },
    "partition": { "enum": ["learning_cycle_1", "learning_cycle_2", "protected_holdout", "postfreeze_audit"] },
    "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
    "core_program_id": { "$ref": "#/$defs/content_id" },
    "encoded_program_id": { "$ref": "#/$defs/content_id" },
    "vocabulary_id": { "$ref": "#/$defs/content_id" },
    "intrinsic_entry_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/content_id" } },
    "intrinsic_static_uses": { "type": "integer", "minimum": 0 },
    "cases_passed": { "type": "integer", "minimum": 1 },
    "cases_total": { "type": "integer", "minimum": 1 },
    "all_outputs_match_oracle": { "const": true },
    "total_dispatches": { "type": "integer", "minimum": 1 },
    "total_steps": { "type": "integer", "minimum": 1 },
    "case_results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case_result" } }
  },
  "$defs": {
    "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "result": {
      "oneOf": [
        { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" },
        { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" } }
      ]
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "actual", "matches_oracle", "matches_core_lowering", "dispatches", "steps"],
      "properties": {
        "case_id": { "$ref": "#/$defs/content_id" },
        "actual": { "$ref": "#/$defs/result" },
        "matches_oracle": { "const": true },
        "matches_core_lowering": { "const": true },
        "dispatches": { "type": "integer", "minimum": 1 },
        "steps": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
