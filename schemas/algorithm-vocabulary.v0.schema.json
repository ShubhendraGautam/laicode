{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/algorithm-vocabulary.v0.schema.json",
  "title": "LAIcode transparent algorithm vocabulary v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kernel_version", "parent_vocabulary_id", "entry_ids", "entries"],
  "properties": {
    "schema_version": { "const": "AlgorithmVocabularyV0" },
    "kernel_version": { "const": "StructuredI64ArrayKernelV0" },
    "parent_vocabulary_id": {
      "oneOf": [
        { "$ref": "#/$defs/content_id" },
        { "type": "null" }
      ]
    },
    "entry_ids": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/content_id" } },
    "entries": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "type_name": { "enum": ["i64", "bool", "array_i64", "pair_i64"] },
    "pattern": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "index", "type"],
          "properties": {
            "op": { "const": "hole" },
            "index": { "type": "integer", "minimum": 0 },
            "type": { "$ref": "#/$defs/type_name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": { "const": "const" },
            "value": { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "arguments"],
          "properties": {
            "op": { "enum": ["len", "get", "add", "sub", "div_trunc", "max", "eq", "lt", "le", "gt", "ge", "and", "pair"] },
            "arguments": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/pattern" } }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "result_type", "hole_types", "lowering", "learner", "provenance", "evidence"],
      "properties": {
        "schema_version": { "const": "AlgorithmVocabularyEntryV0" },
        "kind": { "const": "transparent_expression_intrinsic" },
        "result_type": { "enum": ["i64", "bool"] },
        "hole_types": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/type_name" } },
        "lowering": { "$ref": "#/$defs/pattern" },
        "learner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "cycle"],
          "properties": {
            "id": { "const": "CrossTaskExpressionPatternLearnerV0" },
            "cycle": { "type": "integer", "minimum": 1 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_catalog_id", "parent_vocabulary_id", "training_task_ids"],
          "properties": {
            "evidence_catalog_id": { "$ref": "#/$defs/content_id" },
            "parent_vocabulary_id": { "$ref": "#/$defs/content_id" },
            "training_task_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "algorithm-program.v0.schema.json#/$defs/identifier" } }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cross_task_occurrences", "primitive_operator_count", "estimated_dispatch_saving"],
          "properties": {
            "cross_task_occurrences": { "type": "integer", "minimum": 2 },
            "primitive_operator_count": { "type": "integer", "minimum": 2 },
            "estimated_dispatch_saving": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
