{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/machine-partition-evaluation.v0.schema.json",
  "title": "Machine-vocabulary partition evaluation v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variant",
    "vocabulary_id",
    "partition",
    "corpus_id",
    "program_ids",
    "encoded_program_ids",
    "boundary_vector_digest",
    "boundary_vectors_checked",
    "exact_lowering_verified",
    "cost",
    "evaluation_id"
  ],
  "properties": {
    "schema_version": { "const": "MachinePartitionEvaluationV0" },
    "variant": { "enum": ["primitive", "learned", "fixed_human", "seeded_random"] },
    "vocabulary_id": { "$ref": "#/$defs/content_id" },
    "partition": { "type": "string", "minLength": 1 },
    "corpus_id": { "$ref": "#/$defs/content_id" },
    "program_ids": { "$ref": "#/$defs/content_ids" },
    "encoded_program_ids": { "$ref": "#/$defs/content_ids" },
    "boundary_vector_digest": { "$ref": "#/$defs/content_id" },
    "boundary_vectors_checked": { "type": "integer", "minimum": 1 },
    "exact_lowering_verified": { "const": true },
    "evaluation_id": { "$ref": "#/$defs/content_id" },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_model",
        "alu_units",
        "dispatch_units",
        "runtime_units",
        "definition_units",
        "verification_units",
        "compilation_units",
        "storage_units",
        "one_time_units",
        "total_units",
        "encoded_bytes",
        "library_bytes"
      ],
      "properties": {
        "cost_model": { "const": "WordDispatchCostModelV0" },
        "alu_units": { "type": "integer", "minimum": 0 },
        "dispatch_units": { "type": "integer", "minimum": 0 },
        "runtime_units": { "type": "integer", "minimum": 0 },
        "definition_units": { "type": "integer", "minimum": 0 },
        "verification_units": { "type": "integer", "minimum": 0 },
        "compilation_units": { "type": "integer", "minimum": 0 },
        "storage_units": { "type": "integer", "minimum": 0 },
        "one_time_units": { "type": "integer", "minimum": 0 },
        "total_units": { "type": "integer", "minimum": 0 },
        "encoded_bytes": { "type": "integer", "minimum": 0 },
        "library_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    }
  }
}
