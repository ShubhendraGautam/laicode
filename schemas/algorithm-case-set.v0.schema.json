{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/algorithm-case-set.v0.schema.json",
  "title": "Algorithm validity case set v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "cases"],
  "properties": {
    "schema_version": { "const": "AlgorithmCaseSetV0" },
    "task_id": { "$ref": "algorithm-program.v0.schema.json#/$defs/identifier" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "result": {
      "oneOf": [
        { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" },
        { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" } }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "nums", "target", "expected"],
      "properties": {
        "case_id": { "$ref": "#/$defs/content_id" },
        "nums": { "type": "array", "items": { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" } },
        "target": { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" },
        "expected": { "$ref": "#/$defs/result" }
      }
    }
  }
}
