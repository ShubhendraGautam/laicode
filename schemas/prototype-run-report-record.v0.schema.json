{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/prototype-run-report-record.v0.schema.json",
  "title": "LAIcode deterministic prototype run report record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report"],
  "properties": {
    "schema_version": { "const": "PrototypeRunReportRecordV0" },
    "report_id": { "$ref": "#/$defs/content_id" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "claim_level",
        "implementation_id",
        "contract_id",
        "experiment_manifest_id",
        "evidence_catalog_id",
        "archived_evidence_catalog_id",
        "evaluator_meta_report_id",
        "offline_decision_id",
        "selected_candidate_id",
        "selected_artifact_id",
        "selected_strategy_id",
        "comparison_decision_ids",
        "prospective_evaluation_ids",
        "audit_report_id",
        "audit_evaluation_ids",
        "inventory",
        "ledger_id",
        "final_event_id",
        "budget",
        "audit_primary_improvement_ppm",
        "prospective_primary_improvement_ppm",
        "archived_payload_bytes_before_report",
        "deployment_performed",
        "research_audit_used_for_selection",
        "limitations"
      ],
      "properties": {
        "schema_version": { "const": "PrototypeRunReportV0" },
        "status": { "const": "complete" },
        "claim_level": { "const": "exploratory_D0_workflow_only" },
        "implementation_id": { "$ref": "#/$defs/content_id" },
        "contract_id": { "$ref": "#/$defs/content_id" },
        "experiment_manifest_id": { "$ref": "#/$defs/content_id" },
        "evidence_catalog_id": { "$ref": "#/$defs/content_id" },
        "archived_evidence_catalog_id": { "$ref": "#/$defs/content_id" },
        "evaluator_meta_report_id": { "$ref": "#/$defs/content_id" },
        "offline_decision_id": { "$ref": "#/$defs/content_id" },
        "selected_candidate_id": { "$ref": "#/$defs/content_id" },
        "selected_artifact_id": { "$ref": "#/$defs/content_id" },
        "selected_strategy_id": { "enum": ["fifo", "lfu", "lru"] },
        "comparison_decision_ids": { "$ref": "#/$defs/content_ids" },
        "prospective_evaluation_ids": { "$ref": "#/$defs/content_ids" },
        "audit_report_id": { "$ref": "#/$defs/content_id" },
        "audit_evaluation_ids": { "$ref": "#/$defs/content_ids" },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_ids",
            "artifact_ids",
            "trace_ids",
            "evaluation_ids"
          ],
          "properties": {
            "candidate_ids": { "$ref": "#/$defs/content_ids" },
            "artifact_ids": { "$ref": "#/$defs/content_ids" },
            "trace_ids": { "$ref": "#/$defs/content_ids" },
            "evaluation_ids": { "$ref": "#/$defs/content_ids" }
          }
        },
        "ledger_id": { "$ref": "#/$defs/content_id" },
        "final_event_id": { "$ref": "#/$defs/content_id" },
        "budget": { "$ref": "#/$defs/budget" },
        "audit_primary_improvement_ppm": { "$ref": "#/$defs/signed_ppm" },
        "prospective_primary_improvement_ppm": { "$ref": "#/$defs/signed_ppm" },
        "archived_payload_bytes_before_report": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "deployment_performed": { "const": false },
        "research_audit_used_for_selection": { "const": false },
        "limitations": {
          "type": "array",
          "prefixItems": [
            { "const": "synthetic_traces_only" },
            { "const": "exploratory_not_confirmatory" },
            { "const": "no_process_isolation_or_containment_claim" },
            { "const": "no_wall_clock_performance_promotion_metric" },
            { "const": "no_candidate_private_state" }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "signed_ppm": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "by_content_id": {
      "type": "object",
      "propertyNames": { "pattern": "^sha256:[0-9a-f]{64}$" },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "candidate_limit",
        "evaluator_queries_total",
        "meta_evaluator_queries",
        "evaluator_query_limit",
        "evaluator_queries_by_artifact",
        "artifact_bytes_by_id",
        "network_bytes",
        "model_tokens",
        "money_microusd",
        "wall_and_cpu_budget_enforcement"
      ],
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 1 },
        "candidate_limit": { "type": "integer", "minimum": 1 },
        "evaluator_queries_total": { "type": "integer", "minimum": 1 },
        "meta_evaluator_queries": { "type": "integer", "minimum": 0 },
        "evaluator_query_limit": { "type": "integer", "minimum": 1 },
        "evaluator_queries_by_artifact": { "$ref": "#/$defs/by_content_id" },
        "artifact_bytes_by_id": { "$ref": "#/$defs/by_content_id" },
        "network_bytes": { "const": 0 },
        "model_tokens": { "const": 0 },
        "money_microusd": { "const": 0 },
        "wall_and_cpu_budget_enforcement": {
          "const": "not_yet_isolated_at_D0"
        }
      }
    }
  },
  "$comment": "The trusted replay path verifies that report_id hashes report, the ledger ends at final_event_id, and a fresh run reproduces every archived byte."
}
