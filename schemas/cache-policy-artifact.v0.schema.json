{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-policy-artifact.v0.schema.json",
  "title": "LAIcode cache-policy artifact v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kernel_version", "contract_id", "program"],
  "properties": {
    "schema_version": { "const": "CachePolicyArtifactV0" },
    "kernel_version": { "const": "CachePolicyKernelV0" },
    "contract_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "program": { "$ref": "cache-policy-ir.v0.schema.json" }
  }
}
