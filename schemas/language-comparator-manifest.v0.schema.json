{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/language-comparator-manifest.v0.schema.json",
  "title": "Cross-language comparator benchmark manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_name",
    "study_mode",
    "source_machine_report_id",
    "evidence_catalog_id",
    "question",
    "claim_separation",
    "pits",
    "protocol",
    "fairness_rules",
    "metrics",
    "language_evolution",
    "adapters",
    "limitations",
    "registered_at"
  ],
  "properties": {
    "schema_version": { "const": "LanguageComparatorManifestV0" },
    "benchmark_name": { "const": "laicode-cross-language-b0-v0" },
    "study_mode": { "const": "exploratory_host_benchmark" },
    "source_machine_report_id": { "$ref": "#/$defs/content_id" },
    "evidence_catalog_id": { "$ref": "#/$defs/content_id" },
    "question": { "type": "string", "minLength": 1 },
    "claim_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learning_curve", "ecosystem_comparison"],
      "properties": {
        "learning_curve": { "const": "compare_laicode_cycles_only" },
        "ecosystem_comparison": { "const": "descriptive_not_causal_language_ranking" }
      }
    },
    "pits": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "corpus_name", "corpus_id", "purpose"],
        "properties": {
          "id": { "enum": ["reuse_holdout", "audit_transfer", "shift_no_reuse"] },
          "corpus_name": { "type": "string", "minLength": 1 },
          "corpus_id": { "$ref": "#/$defs/content_id" },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "steady_state_trials",
        "warmup_runs",
        "startup_trials",
        "aot_build_trials",
        "checksum",
        "inputs",
        "compiler_flags",
        "timer",
        "trial_summary"
      ],
      "properties": {
        "scale": { "type": "integer", "minimum": 1 },
        "steady_state_trials": { "type": "integer", "minimum": 3 },
        "warmup_runs": { "type": "integer", "minimum": 1 },
        "startup_trials": { "type": "integer", "minimum": 3 },
        "aot_build_trials": { "type": "integer", "minimum": 3 },
        "checksum": { "type": "string", "minLength": 1 },
        "inputs": { "type": "string", "minLength": 1 },
        "compiler_flags": { "$ref": "#/$defs/nonempty_strings" },
        "timer": { "type": "string", "minLength": 1 },
        "trial_summary": { "type": "string", "minLength": 1 }
      }
    },
    "fairness_rules": { "$ref": "#/$defs/nonempty_strings" },
    "metrics": { "$ref": "#/$defs/nonempty_strings" },
    "language_evolution": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycle",
          "vocabulary_id",
          "entry_count",
          "weighted_dispatch_tokens_by_pit"
        ],
        "properties": {
          "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
          "vocabulary_id": { "$ref": "#/$defs/content_id" },
          "entry_count": { "type": "integer", "minimum": 0, "maximum": 2 },
          "weighted_dispatch_tokens_by_pit": { "$ref": "#/$defs/pit_counts" }
        }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "learning_cycle",
          "execution_model",
          "source",
          "tool",
          "tool_kind",
          "required"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "learning_cycle": {
            "oneOf": [
              { "type": "integer", "minimum": 0, "maximum": 2 },
              { "type": "null" }
            ]
          },
          "execution_model": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "pattern": "^sources/" },
          "tool": { "type": "string", "minLength": 1 },
          "tool_kind": { "enum": ["c_compiler", "interpreter"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "limitations": { "$ref": "#/$defs/nonempty_strings" },
    "registered_at": { "const": "2026-08-01T00:00:00Z" }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pit_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reuse_holdout", "audit_transfer", "shift_no_reuse"],
      "properties": {
        "reuse_holdout": { "type": "integer", "minimum": 0 },
        "audit_transfer": { "type": "integer", "minimum": 0 },
        "shift_no_reuse": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
