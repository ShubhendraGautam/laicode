{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/function-native-validity-report-record.v2.schema.json",
  "title": "Native function validity report record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report"],
  "properties": {
    "schema_version": { "const": "FunctionNativeValidityReportRecordV2" },
    "report_id": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_function_report_id", "host", "compiler", "translations", "translations_passed", "cases_passed", "checksum_stable_across_cycles", "all_valid", "performance_claim"],
      "properties": {
        "schema_version": { "const": "FunctionNativeValidityReportV2" },
        "source_function_report_id": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" },
        "host": {
          "type": "object", "additionalProperties": false, "required": ["system", "release", "machine"],
          "properties": { "system": { "type": "string", "minLength": 1 }, "release": { "type": "string", "minLength": 1 }, "machine": { "type": "string", "minLength": 1 } }
        },
        "compiler": {
          "type": "object", "additionalProperties": false, "required": ["requested", "resolved_path", "version", "flags"],
          "properties": {
            "requested": { "type": "string", "minLength": 1 }, "resolved_path": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
            "flags": { "const": ["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-Wconversion", "-Wshadow", "-pedantic"] }
          }
        },
        "translations": { "type": "array", "minItems": 13, "maxItems": 13, "items": { "$ref": "#/$defs/translation" } },
        "translations_passed": { "const": 13 }, "cases_passed": { "const": 416 },
        "checksum_stable_across_cycles": { "const": true },
        "all_valid": { "const": true }, "performance_claim": { "const": false }
      }
    }
  },
  "$defs": {
    "translation": {
      "type": "object", "additionalProperties": false,
      "required": ["cycle", "task_id", "source_sha256", "artifact_sha256", "artifact_bytes", "cases_passed", "checksum", "valid"],
      "properties": {
        "cycle": { "type": "integer", "minimum": 0, "maximum": 2 }, "task_id": { "$ref": "function-language-defs.v2.schema.json#/$defs/identifier" },
        "source_sha256": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" }, "artifact_sha256": { "$ref": "function-language-defs.v2.schema.json#/$defs/content_id" },
        "artifact_bytes": { "type": "integer", "minimum": 1 }, "cases_passed": { "const": 32 }, "checksum": { "type": "string", "pattern": "^[0-9a-f]{16}$" }, "valid": { "const": true }
      }
    }
  },
  "$comment": "checksum_stable_across_cycles asserts that every cycle of a task produced the same native result checksum, so learned abstraction did not change compiled behaviour."
}
