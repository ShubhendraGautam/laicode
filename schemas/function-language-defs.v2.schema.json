{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/function-language-defs.v2.schema.json",
  "title": "LAIcode A2 function language shared definitions",
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "i64": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
    "parameter_type": { "enum": ["i64", "bool", "array_i64"] },
    "return_type": { "enum": ["i64", "bool"] },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type"],
      "properties": { "name": { "$ref": "#/$defs/identifier" }, "type": { "$ref": "#/$defs/parameter_type" } }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "value"],
          "properties": { "op": { "const": "const" }, "value": { "$ref": "#/$defs/i64" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "name"],
          "properties": { "op": { "const": "var" }, "name": { "$ref": "#/$defs/identifier" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "name", "arguments"],
          "properties": {
            "op": { "const": "call" },
            "name": { "$ref": "#/$defs/identifier" },
            "arguments": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/expression" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "entry_id", "arguments"],
          "properties": {
            "op": { "const": "learned_call" },
            "entry_id": { "$ref": "#/$defs/content_id" },
            "arguments": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/expression" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "arguments"],
          "properties": {
            "op": { "const": "len" },
            "arguments": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/expression" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "arguments"],
          "properties": {
            "op": { "enum": ["get", "add", "sub", "eq", "ne", "lt", "le", "gt", "ge"] },
            "arguments": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/expression" } }
          }
        }
      ]
    },
    "statement": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "name", "value"],
          "properties": { "op": { "enum": ["let", "assign"] }, "name": { "$ref": "#/$defs/identifier" }, "value": { "$ref": "#/$defs/expression" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "index", "start", "stop", "body"],
          "properties": {
            "op": { "const": "for_range" }, "index": { "$ref": "#/$defs/identifier" },
            "start": { "$ref": "#/$defs/expression" }, "stop": { "$ref": "#/$defs/expression" },
            "body": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/statement" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "condition", "then", "else"],
          "properties": {
            "op": { "const": "if" }, "condition": { "$ref": "#/$defs/expression" },
            "then": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
            "else": { "type": "array", "items": { "$ref": "#/$defs/statement" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "value"],
          "properties": { "op": { "const": "return" }, "value": { "$ref": "#/$defs/expression" } }
        }
      ]
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "parameters", "return_type", "body"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "parameters": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/parameter" } },
        "return_type": { "$ref": "#/$defs/return_type" },
        "body": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/statement" } }
      }
    }
  },
  "$comment": "The trusted decoder additionally resolves calls against earlier declarations only, rejects recursion and unreachable functions, bounds static call depth, and requires each function to end with its only top-level return."
}
