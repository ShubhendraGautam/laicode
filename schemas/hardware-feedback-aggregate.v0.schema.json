{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/hardware-feedback-aggregate.v0.schema.json",
  "title": "Replicated hardware-feedback aggregate v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_manifest_id",
    "target_id",
    "comparator_package_id",
    "session_report_ids",
    "session_count",
    "pit_aggregates",
    "all_correctness_checks_passed",
    "negative_results_retained"
  ],
  "properties": {
    "schema_version": { "const": "HardwareFeedbackAggregateV0" },
    "study_manifest_id": { "$ref": "#/$defs/content_id" },
    "target_id": { "$ref": "#/$defs/content_id" },
    "comparator_package_id": { "$ref": "#/$defs/content_id" },
    "session_report_ids": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "session_count": { "type": "integer", "minimum": 3 },
    "pit_aggregates": { "$ref": "#/$defs/pit_map" },
    "all_correctness_checks_passed": { "const": true },
    "negative_results_retained": { "const": true }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cycle_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle",
        "vocabulary_id",
        "entry_count",
        "weighted_dispatch_tokens",
        "deterministic_token_reduction_vs_cycle_0",
        "session_median_ns",
        "median_of_session_medians_ns",
        "paired_improvement_ppm_vs_cycle_0",
        "median_improvement_ppm_vs_cycle_0",
        "paired_wins_vs_cycle_0",
        "eligible",
        "eligibility_reasons"
      ],
      "properties": {
        "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
        "vocabulary_id": { "$ref": "#/$defs/content_id" },
        "entry_count": { "type": "integer", "minimum": 0, "maximum": 2 },
        "weighted_dispatch_tokens": { "type": "integer", "minimum": 1 },
        "deterministic_token_reduction_vs_cycle_0": { "type": "integer" },
        "session_median_ns": { "$ref": "#/$defs/positive_integers" },
        "median_of_session_medians_ns": { "type": "integer", "minimum": 1 },
        "paired_improvement_ppm_vs_cycle_0": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "integer" }
        },
        "median_improvement_ppm_vs_cycle_0": { "type": "integer" },
        "paired_wins_vs_cycle_0": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "boolean" },
        "eligibility_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_evidence",
        "eligible_cycles",
        "selected_cycle",
        "selected_vocabulary_id"
      ],
      "properties": {
        "cycle_evidence": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/cycle_row" }
        },
        "eligible_cycles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 2 }
        },
        "selected_cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
        "selected_vocabulary_id": { "$ref": "#/$defs/content_id" }
      }
    },
    "pit_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reuse_holdout", "audit_transfer", "shift_no_reuse"],
      "properties": {
        "reuse_holdout": { "$ref": "#/$defs/pit" },
        "audit_transfer": { "$ref": "#/$defs/pit" },
        "shift_no_reuse": { "$ref": "#/$defs/pit" }
      }
    },
    "positive_integers": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
