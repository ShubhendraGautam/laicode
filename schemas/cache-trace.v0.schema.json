{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-trace.v0.schema.json",
  "title": "LAIcode deterministic cache trace v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "name",
    "scenario",
    "seed",
    "capacity",
    "event_count",
    "events"
  ],
  "properties": {
    "schema_version": { "const": "CacheTraceV0" },
    "generator": { "const": "SplitMix64V0" },
    "name": { "$ref": "#/$defs/key" },
    "scenario": {
      "enum": ["scan_resistance", "recency_shift", "mixed_bursts"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "event_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "key", "pinned_keys"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "key": { "$ref": "#/$defs/key" },
        "pinned_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    }
  },
  "$comment": "The trusted decoder additionally requires event_count to equal array length and sequence to be contiguous from zero. Pin arrays are normalized as semantic sets."
}
