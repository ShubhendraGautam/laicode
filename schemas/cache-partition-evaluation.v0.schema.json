{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-partition-evaluation.v0.schema.json",
  "title": "LAIcode cache partition evaluation v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partition",
    "artifact_id",
    "strategy_id",
    "trace_ids",
    "result_ids",
    "metrics",
    "results",
    "observations_included"
  ],
  "properties": {
    "schema_version": { "const": "CachePartitionEvaluationV0" },
    "partition": {
      "enum": [
        "search",
        "operational_holdout",
        "research_audit",
        "prospective",
        "historical_regression"
      ]
    },
    "artifact_id": { "$ref": "#/$defs/content_id" },
    "strategy_id": { "enum": ["fifo", "lfu", "lru"] },
    "trace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "result_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "accesses",
        "hits",
        "misses",
        "evictions",
        "blocked_insertions",
        "policy_invocations",
        "candidate_violations",
        "policy_errors",
        "fallbacks",
        "miss_ratio_ppm",
        "invalid_decision_rate_ppm",
        "total_decision_steps",
        "p99_decision_steps",
        "hard_constraints_pass"
      ],
      "properties": {
        "schema_version": { "const": "CacheEvaluationMetricsV0" },
        "accesses": { "$ref": "#/$defs/nonnegative" },
        "hits": { "$ref": "#/$defs/nonnegative" },
        "misses": { "$ref": "#/$defs/nonnegative" },
        "evictions": { "$ref": "#/$defs/nonnegative" },
        "blocked_insertions": { "$ref": "#/$defs/nonnegative" },
        "policy_invocations": { "$ref": "#/$defs/nonnegative" },
        "candidate_violations": { "$ref": "#/$defs/nonnegative" },
        "policy_errors": { "$ref": "#/$defs/nonnegative" },
        "fallbacks": { "$ref": "#/$defs/nonnegative" },
        "miss_ratio_ppm": { "$ref": "#/$defs/ppm" },
        "invalid_decision_rate_ppm": { "$ref": "#/$defs/ppm" },
        "total_decision_steps": { "$ref": "#/$defs/nonnegative" },
        "p99_decision_steps": { "$ref": "#/$defs/nonnegative" },
        "hard_constraints_pass": { "type": "boolean" }
      }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "cache-simulation-result.v0.schema.json" }
    },
    "observations_included": { "type": "boolean" }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 }
  },
  "$comment": "The trusted evaluator additionally checks trace/result array alignment and recomputes every aggregate from full results. Aggregate disclosures intentionally set results=[] and observations_included=false."
}
