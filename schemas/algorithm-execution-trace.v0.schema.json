{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/algorithm-execution-trace.v0.schema.json",
  "title": "Algorithm execution trace v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "cycle", "case_id", "events", "truncated"],
  "properties": {
    "schema_version": { "const": "AlgorithmExecutionTraceV0" },
    "task_id": { "$ref": "algorithm-program.v0.schema.json#/$defs/identifier" },
    "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
    "case_id": { "$ref": "#/$defs/content_id" },
    "events": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/event" } },
    "truncated": { "type": "boolean" }
  },
  "$defs": {
    "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "result": {
      "oneOf": [
        { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" } }
      ]
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "name", "value"],
          "properties": {
            "event": { "enum": ["let", "assign"] },
            "name": { "$ref": "algorithm-program.v0.schema.json#/$defs/identifier" },
            "value": { "$ref": "#/$defs/result" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "index", "value"],
          "properties": {
            "event": { "const": "for_iteration" },
            "index": { "$ref": "algorithm-program.v0.schema.json#/$defs/identifier" },
            "value": { "$ref": "algorithm-program.v0.schema.json#/$defs/i64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "iteration"],
          "properties": {
            "event": { "const": "while_iteration" },
            "iteration": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "branch"],
          "properties": {
            "event": { "const": "if" },
            "branch": { "enum": ["then", "else"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "value"],
          "properties": {
            "event": { "const": "return" },
            "value": { "$ref": "#/$defs/result" }
          }
        }
      ]
    }
  }
}
