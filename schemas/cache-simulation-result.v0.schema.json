{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-simulation-result.v0.schema.json",
  "title": "LAIcode deterministic cache simulation result v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "strategy_id",
    "trace_id",
    "metrics",
    "observations",
    "final_resident_keys"
  ],
  "properties": {
    "schema_version": { "const": "CacheSimulationResultV0" },
    "subject_id": { "type": "string", "minLength": 1 },
    "strategy_id": { "type": "string", "minLength": 1 },
    "trace_id": { "$ref": "#/$defs/content_id" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "final_resident_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
    },
    "nullable_key": {
      "oneOf": [{ "$ref": "#/$defs/key" }, { "type": "null" }]
    },
    "nullable_id": {
      "oneOf": [{ "$ref": "#/$defs/content_id" }, { "type": "null" }]
    },
    "nullable_string": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "accesses",
        "hits",
        "misses",
        "evictions",
        "blocked_insertions",
        "policy_invocations",
        "candidate_violations",
        "policy_errors",
        "fallbacks",
        "miss_ratio_ppm",
        "invalid_decision_rate_ppm",
        "total_decision_steps",
        "p99_decision_steps"
      ],
      "properties": {
        "schema_version": { "const": "CacheMetricsV0" },
        "accesses": { "$ref": "#/$defs/nonnegative" },
        "hits": { "$ref": "#/$defs/nonnegative" },
        "misses": { "$ref": "#/$defs/nonnegative" },
        "evictions": { "$ref": "#/$defs/nonnegative" },
        "blocked_insertions": { "$ref": "#/$defs/nonnegative" },
        "policy_invocations": { "$ref": "#/$defs/nonnegative" },
        "candidate_violations": { "$ref": "#/$defs/nonnegative" },
        "policy_errors": { "$ref": "#/$defs/nonnegative" },
        "fallbacks": { "$ref": "#/$defs/nonnegative" },
        "miss_ratio_ppm": { "$ref": "#/$defs/ppm" },
        "invalid_decision_rate_ppm": { "$ref": "#/$defs/ppm" },
        "total_decision_steps": { "$ref": "#/$defs/nonnegative" },
        "p99_decision_steps": { "$ref": "#/$defs/nonnegative" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sequence",
        "request_key",
        "outcome",
        "snapshot_id",
        "candidate_choice",
        "applied_choice",
        "used_fallback",
        "violation",
        "semantic_steps",
        "resident_keys_after"
      ],
      "properties": {
        "schema_version": { "const": "CacheObservationV0" },
        "sequence": { "$ref": "#/$defs/nonnegative" },
        "request_key": { "$ref": "#/$defs/key" },
        "outcome": {
          "enum": ["hit", "miss_insert", "miss_blocked", "miss_evict"]
        },
        "snapshot_id": { "$ref": "#/$defs/nullable_id" },
        "candidate_choice": { "$ref": "#/$defs/nullable_key" },
        "applied_choice": { "$ref": "#/$defs/nullable_key" },
        "used_fallback": { "type": "boolean" },
        "violation": { "$ref": "#/$defs/nullable_string" },
        "semantic_steps": { "$ref": "#/$defs/nonnegative" },
        "resident_keys_after": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    }
  }
}
