{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/offline-selection-decision.v0.schema.json",
  "title": "LAIcode offline selection decision v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_manifest_id",
    "original_candidate_id",
    "original_artifact_id",
    "comparison_decision_ids",
    "search_ranking_artifact_ids",
    "selected_candidate_id",
    "selected_artifact_id",
    "selected_strategy_id",
    "outcome",
    "selection_rule",
    "deployment_authority",
    "research_audit_evaluation_ids"
  ],
  "properties": {
    "schema_version": { "const": "OfflineSelectionDecisionV0" },
    "experiment_manifest_id": { "$ref": "#/$defs/content_id" },
    "original_candidate_id": { "$ref": "#/$defs/content_id" },
    "original_artifact_id": { "$ref": "#/$defs/content_id" },
    "comparison_decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "search_ranking_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "selected_candidate_id": { "$ref": "#/$defs/content_id" },
    "selected_artifact_id": { "$ref": "#/$defs/content_id" },
    "selected_strategy_id": { "enum": ["fifo", "lfu", "lru"] },
    "outcome": {
      "enum": ["challenger_selected_offline", "baseline_retained_offline"]
    },
    "selection_rule": {
      "const": "all_gates_then_largest_primary_improvement_then_lower_risk_then_id"
    },
    "deployment_authority": { "const": "D0_offline_only" },
    "research_audit_evaluation_ids": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
