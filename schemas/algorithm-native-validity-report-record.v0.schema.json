{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/algorithm-native-validity-report-record.v0.schema.json",
  "title": "Native algorithm validity report record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report"],
  "properties": {
    "schema_version": { "const": "AlgorithmNativeValidityReportRecordV0" },
    "report_id": { "$ref": "#/$defs/content_id" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_algorithm_report_id", "host", "compiler", "translations", "translations_passed", "cases_passed", "all_valid", "performance_claim"],
      "properties": {
        "schema_version": { "const": "AlgorithmNativeValidityReportV0" },
        "source_algorithm_report_id": { "$ref": "#/$defs/content_id" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "release", "machine"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "minLength": 1 },
            "machine": { "type": "string", "minLength": 1 }
          }
        },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "resolved_path", "version", "flags"],
          "properties": {
            "requested": { "type": "string", "minLength": 1 },
            "resolved_path": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "flags": { "const": ["-O2", "-std=c11", "-Wall", "-Wextra", "-Werror"] }
          }
        },
        "translations": { "type": "array", "minItems": 13, "maxItems": 13, "items": { "$ref": "#/$defs/translation" } },
        "translations_passed": { "const": 13 },
        "cases_passed": { "const": 416 },
        "all_valid": { "const": true },
        "performance_claim": { "const": false }
      }
    }
  },
  "$defs": {
    "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "task_id", "source_sha256", "artifact_sha256", "artifact_bytes", "cases_passed", "checksum", "valid"],
      "properties": {
        "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
        "task_id": { "$ref": "algorithm-program.v0.schema.json#/$defs/identifier" },
        "source_sha256": { "$ref": "#/$defs/content_id" },
        "artifact_sha256": { "$ref": "#/$defs/content_id" },
        "artifact_bytes": { "type": "integer", "minimum": 1 },
        "cases_passed": { "const": 32 },
        "checksum": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "valid": { "const": true }
      }
    }
  }
}
