{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/word-pipeline.v0.schema.json",
  "title": "LAIcode pure 64-bit word pipeline v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_type",
    "output_type",
    "effects",
    "instructions"
  ],
  "properties": {
    "schema_version": { "const": "WordPipelineV0" },
    "input_type": { "const": "u64" },
    "output_type": { "const": "u64" },
    "effects": { "type": "array", "maxItems": 0 },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/instruction" }
    }
  },
  "$defs": {
    "instruction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "operand"],
          "properties": {
            "op": {
              "enum": [
                "xor_const",
                "add_const",
                "multiply_const",
                "and_const",
                "or_const"
              ]
            },
            "operand": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "operand"],
          "properties": {
            "op": { "enum": ["xor_shift_right", "rotate_left"] },
            "operand": { "type": "integer", "minimum": 1, "maximum": 63 }
          }
        }
      ]
    }
  },
  "$comment": "Every instruction is total over u64 with fixed modulo-2^64 semantics and no effects."
}
