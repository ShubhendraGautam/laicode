{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/collection-case-set.v1.schema.json",
  "title": "Collection-language deterministic oracle cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "generator", "case_count", "cases"],
  "properties": {
    "schema_version": { "const": "CollectionCaseSetV1" },
    "task_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" },
    "generator": { "const": "splitmix64_collection_cases_v1" },
    "case_count": { "const": 32 },
    "cases": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "nums", "target", "expected"],
      "properties": {
        "case_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
        "nums": { "type": "array", "maxItems": 256, "items": { "$ref": "collection-language-defs.v1.schema.json#/$defs/i64" } },
        "target": { "$ref": "collection-language-defs.v1.schema.json#/$defs/i64" },
        "expected": { "$ref": "collection-language-defs.v1.schema.json#/$defs/result" }
      }
    }
  }
}
