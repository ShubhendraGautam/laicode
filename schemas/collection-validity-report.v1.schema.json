{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/collection-validity-report.v1.schema.json",
  "title": "Collection interpreter validity report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "partition", "cycle", "core_program_id", "encoded_program_id", "vocabulary_id", "intrinsic_entry_ids", "intrinsic_static_uses", "cases_passed", "cases_total", "all_outputs_match_oracle", "total_dispatches", "total_steps", "case_results"],
  "properties": {
    "schema_version": { "const": "CollectionValidityReportV1" },
    "task_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" },
    "partition": { "enum": ["learning_cycle_1", "learning_cycle_2", "protected_holdout", "postfreeze_audit"] },
    "cycle": { "type": "integer", "minimum": 0, "maximum": 2 },
    "core_program_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
    "encoded_program_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
    "vocabulary_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
    "intrinsic_entry_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" } },
    "intrinsic_static_uses": { "type": "integer", "minimum": 0 },
    "cases_passed": { "const": 32 },
    "cases_total": { "const": 32 },
    "all_outputs_match_oracle": { "const": true },
    "total_dispatches": { "type": "integer", "minimum": 1 },
    "total_steps": { "type": "integer", "minimum": 1 },
    "case_results": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "$ref": "#/$defs/case_result" } }
  },
  "$defs": {
    "case_result": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "actual", "matches_oracle", "matches_core_lowering", "dispatches", "steps"],
      "properties": {
        "case_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
        "actual": { "$ref": "collection-language-defs.v1.schema.json#/$defs/result" },
        "matches_oracle": { "const": true },
        "matches_core_lowering": { "const": true },
        "dispatches": { "type": "integer", "minimum": 1 },
        "steps": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
