{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/collection-vocabulary.v1.schema.json",
  "title": "LAIcode transparent collection statement vocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kernel_version", "parent_vocabulary_id", "entry_ids", "entries"],
  "properties": {
    "schema_version": { "const": "CollectionVocabularyV1" },
    "kernel_version": { "const": "OwnedVectorRecordKernelV1" },
    "parent_vocabulary_id": { "oneOf": [{ "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" }, { "type": "null" }] },
    "entry_ids": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" } },
    "entries": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "argument_types", "lowering", "learner", "provenance", "evidence"],
      "properties": {
        "schema_version": { "const": "CollectionVocabularyEntryV1" },
        "kind": { "enum": ["push_indexed", "append_indexed_if"] },
        "argument_types": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "collection-language-defs.v1.schema.json#/$defs/type_name" } },
        "lowering": { "type": "object" },
        "learner": {
          "type": "object", "additionalProperties": false, "required": ["id", "cycle"],
          "properties": { "id": { "const": "CrossTaskStatementPatternLearnerV1" }, "cycle": { "type": "integer", "minimum": 1, "maximum": 2 } }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["evidence_catalog_id", "parent_vocabulary_id", "training_task_ids"],
          "properties": {
            "evidence_catalog_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
            "parent_vocabulary_id": { "$ref": "collection-language-defs.v1.schema.json#/$defs/content_id" },
            "training_task_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "collection-language-defs.v1.schema.json#/$defs/identifier" } }
          }
        },
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["cross_task_occurrences", "primitive_operator_count", "estimated_dispatch_saving"],
          "properties": {
            "cross_task_occurrences": { "type": "integer", "minimum": 2 },
            "primitive_operator_count": { "type": "integer", "minimum": 2, "maximum": 3 },
            "estimated_dispatch_saving": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "$comment": "The trusted decoder requires each kind's exact argument types and canonical transparent lowering tree."
}
