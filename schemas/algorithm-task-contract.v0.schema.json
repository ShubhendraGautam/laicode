{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/algorithm-task-contract.v0.schema.json",
  "title": "Algorithm validity task contract v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "partition", "platform_analogue", "compatibility_claim", "input", "output", "preconditions", "oracle", "program_id", "case_count", "case_set_id"],
  "properties": {
    "schema_version": { "const": "AlgorithmTaskContractV0" },
    "task_id": { "$ref": "algorithm-program.v0.schema.json#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1 },
    "partition": { "enum": ["learning_cycle_1", "learning_cycle_2", "protected_holdout", "postfreeze_audit"] },
    "platform_analogue": { "type": "string", "minLength": 1 },
    "compatibility_claim": { "enum": ["training_task_not_platform_acceptance_claim", "contract_equivalent_locally_not_official_submission"] },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nums", "target"],
      "properties": { "nums": { "const": "array_i64" }, "target": { "const": "i64" } }
    },
    "output": { "enum": ["i64", "pair_i64"] },
    "preconditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "oracle": { "const": "independent_trusted_python_reference_v0" },
    "program_id": { "$ref": "#/$defs/content_id" },
    "case_count": { "type": "integer", "minimum": 1 },
    "case_set_id": { "$ref": "#/$defs/content_id" }
  },
  "$defs": {
    "content_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
