{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/machine-host-measurement-record.v0.schema.json",
  "title": "Generated-C machine-language host measurement record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report"],
  "properties": {
    "schema_version": { "const": "MachineHostMeasurementRecordV0" },
    "report_id": { "$ref": "#/$defs/content_id" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_run_report_id",
        "source_bundle_exactly_replayed_before_measurement",
        "adapter",
        "compiler",
        "host",
        "measurement",
        "deterministic_model",
        "result",
        "artifacts",
        "limitations"
      ],
      "properties": {
        "schema_version": { "const": "MachineHostMeasurementV0" },
        "source_run_report_id": { "$ref": "#/$defs/content_id" },
        "source_bundle_exactly_replayed_before_measurement": { "const": true },
        "adapter": { "const": "GeneratedCVolatileSwitchInterpreterV0" },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "resolved_path", "version", "flags"],
          "properties": {
            "requested": { "type": "string", "minLength": 1 },
            "resolved_path": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "flags": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "release", "machine", "cpu_model"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "minLength": 1 },
            "machine": { "type": "string", "minLength": 1 },
            "cpu_model": { "type": "string", "minLength": 1 }
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clock",
            "trials",
            "scale",
            "order",
            "primitive_ns",
            "learned_ns",
            "primitive_median_ns",
            "learned_median_ns",
            "learned_trial_wins",
            "primitive_checksum",
            "learned_checksum",
            "checksums_match"
          ],
          "properties": {
            "clock": { "const": "CLOCK_MONOTONIC" },
            "trials": { "type": "integer", "minimum": 3 },
            "scale": { "type": "integer", "minimum": 1 },
            "order": { "const": "alternating_primitive_first_and_learned_first" },
            "primitive_ns": { "$ref": "#/$defs/timings" },
            "learned_ns": { "$ref": "#/$defs/timings" },
            "primitive_median_ns": { "type": "integer", "minimum": 1 },
            "learned_median_ns": { "type": "integer", "minimum": 1 },
            "learned_trial_wins": { "type": "integer", "minimum": 0 },
            "primitive_checksum": { "$ref": "#/$defs/word" },
            "learned_checksum": { "$ref": "#/$defs/word" },
            "checksums_match": { "const": true }
          }
        },
        "deterministic_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primitive_runtime_units", "learned_runtime_units", "predicts_learned_faster"],
          "properties": {
            "primitive_runtime_units": { "type": "integer", "minimum": 0 },
            "learned_runtime_units": { "type": "integer", "minimum": 0 },
            "predicts_learned_faster": { "type": "boolean" }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host_observes_learned_faster_at_median",
            "model_direction_agrees",
            "majority_of_trials_agree",
            "used_for_deterministic_identity_or_selection"
          ],
          "properties": {
            "host_observes_learned_faster_at_median": { "type": "boolean" },
            "model_direction_agrees": { "type": "boolean" },
            "majority_of_trials_agree": { "type": "boolean" },
            "used_for_deterministic_identity_or_selection": { "const": false }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_sha256", "binary_sha256", "raw_stdout_sha256"],
          "properties": {
            "source_sha256": { "$ref": "#/$defs/content_id" },
            "binary_sha256": { "$ref": "#/$defs/content_id" },
            "raw_stdout_sha256": { "$ref": "#/$defs/content_id" }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timings": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "integer", "minimum": 1 }
    },
    "word": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    }
  }
}
