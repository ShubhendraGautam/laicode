{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/encoded-function-program.v2.schema.json",
  "title": "LAIcode encoded bounded-function call-graph program v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kernel_version", "task_id", "parameters", "return_type", "effects", "functions"],
  "properties": {
    "schema_version": { "const": "EncodedFunctionProgramV2" },
    "kernel_version": { "const": "CallGraphFunctionKernelV2" },
    "task_id": { "$ref": "function-language-defs.v2.schema.json#/$defs/identifier" },
    "parameters": { "const": [{ "name": "nums", "type": "array_i64" }, { "name": "target", "type": "i64" }] },
    "return_type": { "const": "i64" },
    "effects": { "const": ["pure_bounded_call_graph"] },
    "functions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "function-language-defs.v2.schema.json#/$defs/function" } }
  },
  "$comment": "An encoded program drops every local definition that a vocabulary entry replaces and rewrites its call sites to learned_call. It must denote exactly the same behaviour and dispatch count as its core program."
}
