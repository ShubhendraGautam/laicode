{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/machine-vocabulary.v0.schema.json",
  "title": "LAIcode transparent learned machine vocabulary v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parent_vocabulary_id",
    "entry_ids",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "MachineVocabularyV0" },
    "parent_vocabulary_id": { "$ref": "#/$defs/nullable_content_id" },
    "entry_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "entries": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_content_id": {
      "oneOf": [
        { "$ref": "#/$defs/content_id" },
        { "type": "null" }
      ]
    },
    "instruction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "operand"],
          "properties": {
            "op": {
              "enum": [
                "xor_const",
                "add_const",
                "multiply_const",
                "and_const",
                "or_const"
              ]
            },
            "operand": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "operand"],
          "properties": {
            "op": { "enum": ["xor_shift_right", "rotate_left"] },
            "operand": { "type": "integer", "minimum": 1, "maximum": 63 }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "lowering",
        "learner",
        "provenance",
        "evidence"
      ],
      "properties": {
        "schema_version": { "const": "LearnedSuperinstructionV0" },
        "type": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "effects"],
          "properties": {
            "input": { "const": "u64" },
            "output": { "const": "u64" },
            "effects": { "type": "array", "maxItems": 0 }
          }
        },
        "lowering": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/instruction" }
        },
        "learner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "cycle"],
          "properties": {
            "id": {
              "enum": [
                "ExecutionWeightedNgramLearnerV0",
                "FixedHumanVocabularyV0",
                "SeededRandomVocabularyV0"
              ]
            },
            "cycle": { "type": "integer", "minimum": 0 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_catalog_id", "parent_vocabulary_id"],
          "properties": {
            "evidence_catalog_id": { "$ref": "#/$defs/content_id" },
            "parent_vocabulary_id": { "$ref": "#/$defs/content_id" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weighted_occurrences", "estimated_saving"],
          "properties": {
            "weighted_occurrences": { "type": "integer", "minimum": 0 },
            "estimated_saving": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "$comment": "The trusted decoder additionally checks entry content identities, ID ordering, parent lineage, and exact lowering."
}
