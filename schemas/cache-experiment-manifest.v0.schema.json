{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-experiment-manifest.v0.schema.json",
  "title": "LAIcode exploratory cache experiment manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_name",
    "title",
    "study_mode",
    "research_question",
    "hypothesis",
    "falsification_condition",
    "repository_revision",
    "implementation_id",
    "contract_id",
    "evidence_catalog_id",
    "archived_evidence_catalog_id",
    "stage",
    "system_profile",
    "maximum_authorized_ceiling",
    "kernel_version",
    "program_schema",
    "action_schema",
    "generator",
    "candidate_ids",
    "artifact_ids",
    "partition_method",
    "trace_specs",
    "primary_outcome",
    "protected_outcome",
    "hard_constraints",
    "promotion_policy",
    "baselines",
    "comparison_budget",
    "audit_use",
    "analysis_command",
    "registered_at"
  ],
  "properties": {
    "schema_version": { "const": "CacheExperimentManifestV0" },
    "experiment_name": { "const": "cache-e1-exploratory-smoke-v0" },
    "title": { "type": "string", "minLength": 1 },
    "study_mode": { "const": "exploratory" },
    "research_question": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "falsification_condition": { "type": "string", "minLength": 1 },
    "repository_revision": { "const": "working-tree-content-addressed" },
    "implementation_id": { "$ref": "#/$defs/content_id" },
    "contract_id": { "$ref": "#/$defs/content_id" },
    "evidence_catalog_id": { "$ref": "#/$defs/content_id" },
    "archived_evidence_catalog_id": { "$ref": "#/$defs/content_id" },
    "stage": { "const": "E1" },
    "system_profile": { "$ref": "#/$defs/system_profile" },
    "maximum_authorized_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m", "d"],
      "properties": {
        "m": { "const": "M1" },
        "d": { "const": "D0" }
      }
    },
    "kernel_version": { "const": "CachePolicyKernelV0" },
    "program_schema": { "const": "CacheStrategySelectionV0" },
    "action_schema": { "const": "CachePolicyActionV0" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "strategy_ids", "learner_update"],
      "properties": {
        "id": { "const": "strategy_enumerator" },
        "version": { "const": "v0" },
        "strategy_ids": {
          "type": "array",
          "prefixItems": [
            { "const": "fifo" },
            { "const": "lfu" },
            { "const": "lru" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "learner_update": { "const": "none" }
      }
    },
    "candidate_ids": { "$ref": "#/$defs/content_ids" },
    "artifact_ids": { "$ref": "#/$defs/content_ids" },
    "partition_method": { "const": "identity_separated_temporal_scenarios" },
    "trace_specs": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/trace_spec" }
    },
    "primary_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "direction"],
      "properties": {
        "id": { "const": "miss_ratio" },
        "unit": { "const": "parts_per_million" },
        "direction": { "const": "minimize" }
      }
    },
    "protected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "statistic", "direction"],
      "properties": {
        "id": { "const": "decision_cost" },
        "unit": { "const": "semantic_steps" },
        "statistic": { "const": "p99_nearest_rank" },
        "direction": { "const": "minimize" }
      }
    },
    "hard_constraints": {
      "type": "array",
      "prefixItems": [
        { "const": "candidate_violations_equal_zero" },
        { "const": "policy_errors_equal_zero" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "promotion_policy": { "$ref": "#/$defs/policy" },
    "baselines": {
      "type": "array",
      "prefixItems": [
        { "const": "original_lru" },
        { "const": "fifo" },
        { "const": "lfu" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "comparison_budget": { "type": "integer", "minimum": 1 },
    "audit_use": { "const": "post_decision_report_only" },
    "analysis_command": { "const": "python3 -m laicode replay-prototype RUN_DIR" },
    "registered_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/content_id" }
    },
    "system_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "m", "g", "l", "d", "f"],
      "properties": {
        "r": { "const": "R2" },
        "m": { "const": "M1" },
        "g": { "const": "G1" },
        "l": { "const": "L0" },
        "d": { "const": "D0" },
        "f": { "const": "F0" }
      }
    },
    "trace_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition", "scenario", "seed", "event_count", "capacity"],
      "properties": {
        "partition": {
          "enum": [
            "search",
            "operational_holdout",
            "research_audit",
            "prospective",
            "historical_regression"
          ]
        },
        "scenario": {
          "enum": ["scan_resistance", "recency_shift", "mixed_bursts"]
        },
        "seed": { "type": "integer", "minimum": 0 },
        "event_count": { "type": "integer", "minimum": 1 },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_version",
        "practical_delta_ppm",
        "protected_tolerance_ppm",
        "historical_regression_tolerance_ppm",
        "minimum_events",
        "maximum_comparisons",
        "epoch_error_budget_ppm",
        "uncertainty_method"
      ],
      "properties": {
        "rule_version": { "const": "CacheConstrainedPromotionV0" },
        "practical_delta_ppm": { "$ref": "#/$defs/ppm" },
        "protected_tolerance_ppm": { "$ref": "#/$defs/ppm" },
        "historical_regression_tolerance_ppm": { "$ref": "#/$defs/ppm" },
        "minimum_events": { "type": "integer", "minimum": 1 },
        "maximum_comparisons": { "type": "integer", "minimum": 1 },
        "epoch_error_budget_ppm": { "$ref": "#/$defs/ppm" },
        "uncertainty_method": { "const": "deterministic_exact_exploratory" }
      }
    }
  }
}
