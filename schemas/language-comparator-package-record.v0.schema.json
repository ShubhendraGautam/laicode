{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/language-comparator-package-record.v0.schema.json",
  "title": "Deterministic language comparator package record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "inventory"],
  "properties": {
    "schema_version": { "const": "LanguageComparatorPackageRecordV0" },
    "package_id": { "$ref": "#/$defs/content_id" },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_manifest_id",
        "reference_results_id",
        "source_sha256_by_path"
      ],
      "properties": {
        "benchmark_manifest_id": { "$ref": "#/$defs/content_id" },
        "reference_results_id": { "$ref": "#/$defs/content_id" },
        "source_sha256_by_path": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^sources/" },
          "additionalProperties": { "$ref": "#/$defs/content_id" }
        }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
