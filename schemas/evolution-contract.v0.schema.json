{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/evolution-contract.v0.schema.json",
  "title": "LAIcode evolution contract prototype v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "epoch",
    "expires_at",
    "subject",
    "profiles",
    "mutation",
    "capabilities",
    "constraints",
    "objectives",
    "comparison",
    "evidence",
    "budgets",
    "halt_conditions"
  ],
  "properties": {
    "schema_version": { "const": "laicode.evolution-contract.v0" },
    "name": { "$ref": "#/$defs/identifier" },
    "epoch": { "$ref": "#/$defs/identifier" },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "subject": { "$ref": "#/$defs/subject" },
    "profiles": { "$ref": "#/$defs/profiles" },
    "mutation": { "$ref": "#/$defs/mutation" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/constraint" }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objective" }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "uncertainty_method",
        "epoch_error_budget_ppm",
        "maximum_comparisons",
        "minimum_events_per_partition",
        "historical_regression_tolerance_ppm",
        "candidate_churn_limit",
        "promotion_limit",
        "tie_breaker"
      ],
      "properties": {
        "method": { "const": "constrained" },
        "uncertainty_method": { "const": "deterministic_exact_exploratory" },
        "epoch_error_budget_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maximum_comparisons": { "$ref": "#/$defs/positive_integer" },
        "minimum_events_per_partition": { "$ref": "#/$defs/positive_integer" },
        "historical_regression_tolerance_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "candidate_churn_limit": { "$ref": "#/$defs/positive_integer" },
        "promotion_limit": { "$ref": "#/$defs/positive_integer" },
        "tie_breaker": { "const": "lower_risk_then_simpler" }
      }
    },
    "evidence": { "$ref": "#/$defs/evidence" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "halt_conditions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "budget_exhaustion",
          "contract_expiry",
          "evaluator_failure",
          "evidence_integrity_failure"
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
    },
    "schema_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*V[0-9]+$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entrypoint",
        "input_schema",
        "output_schema",
        "correctness_oracle",
        "fallback",
        "state"
      ],
      "properties": {
        "kind": { "const": "pure_function" },
        "entrypoint": { "$ref": "#/$defs/identifier" },
        "input_schema": { "$ref": "#/$defs/schema_id" },
        "output_schema": { "$ref": "#/$defs/schema_id" },
        "correctness_oracle": { "$ref": "#/$defs/identifier" },
        "fallback": { "$ref": "#/$defs/identifier" },
        "state": { "const": "none" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "m", "g", "l", "d", "f"],
      "properties": {
        "r": { "enum": ["R0", "R1", "R2", "R3", "R4", "R5"] },
        "m": { "enum": ["M0", "M1", "M2", "M3", "M4", "M5"] },
        "g": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5"] },
        "l": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
        "d": { "enum": ["D0", "D1", "D2", "D3", "D4", "D5"] },
        "f": { "enum": ["F0", "F1", "F2", "F3"] }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "maximum_reviewed"],
      "properties": {
        "initial": { "$ref": "#/$defs/profile" },
        "maximum_reviewed": { "$ref": "#/$defs/profile" }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "kind",
        "candidate_ir",
        "allowed_strategy_ids",
        "mutable_regions",
        "max_artifact_bytes"
      ],
      "properties": {
        "level": { "enum": ["M0", "M1", "M2", "M3"] },
        "kind": { "enum": ["none", "strategy_selection", "typed_parameters", "typed_ir"] },
        "candidate_ir": { "$ref": "#/$defs/schema_id" },
        "allowed_strategy_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "mutable_regions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "max_artifact_bytes": { "$ref": "#/$defs/positive_integer" }
      }
    },
    "capability_value": {
      "enum": ["deny", "brokered_read", "brokered_call"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "filesystem",
        "network",
        "process",
        "clock",
        "randomness",
        "environment",
        "credentials",
        "model",
        "external_services"
      ],
      "properties": {
        "default": { "const": "deny" },
        "filesystem": { "$ref": "#/$defs/capability_value" },
        "network": { "$ref": "#/$defs/capability_value" },
        "process": { "$ref": "#/$defs/capability_value" },
        "clock": { "$ref": "#/$defs/capability_value" },
        "randomness": { "$ref": "#/$defs/capability_value" },
        "environment": { "$ref": "#/$defs/capability_value" },
        "credentials": { "$ref": "#/$defs/capability_value" },
        "model": { "$ref": "#/$defs/capability_value" },
        "external_services": { "$ref": "#/$defs/capability_value" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enforcement", "oracle", "failure_action"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "enforcement": {
          "enum": ["prove", "runtime_enforce", "test", "statistically_monitor"]
        },
        "oracle": { "$ref": "#/$defs/identifier" },
        "failure_action": {
          "enum": [
            "reject_candidate",
            "fallback",
            "terminate_candidate",
            "halt_epoch",
            "rollback"
          ]
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
        "role",
        "unit",
        "population",
        "denominator",
        "window",
        "missing_data",
        "practical_delta_ppm",
        "noninferiority_tolerance_ppm"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["minimize", "maximize"] },
        "role": { "enum": ["primary", "protected", "secondary"] },
        "unit": { "$ref": "#/$defs/identifier" },
        "population": { "$ref": "#/$defs/identifier" },
        "denominator": { "$ref": "#/$defs/identifier" },
        "window": { "$ref": "#/$defs/identifier" },
        "missing_data": { "enum": ["reject_candidate", "worst_case"] },
        "practical_delta_ppm": { "$ref": "#/$defs/nonnegative_integer" },
        "noninferiority_tolerance_ppm": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "candidate_access", "disclosure"],
      "properties": {
        "source": { "$ref": "#/$defs/identifier" },
        "candidate_access": { "type": "boolean" },
        "disclosure": { "enum": ["none", "aggregate", "full"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search",
        "operational_holdout",
        "research_audit",
        "prospective",
        "historical_regression"
      ],
      "properties": {
        "search": { "$ref": "#/$defs/partition" },
        "operational_holdout": { "$ref": "#/$defs/partition" },
        "research_audit": { "$ref": "#/$defs/partition" },
        "prospective": { "$ref": "#/$defs/partition" },
        "historical_regression": { "$ref": "#/$defs/partition" }
      }
    },
    "candidate_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_milliseconds",
        "wall_milliseconds",
        "memory_bytes",
        "storage_bytes",
        "processes",
        "network_bytes",
        "evaluator_queries",
        "model_tokens",
        "money_microusd"
      ],
      "properties": {
        "cpu_milliseconds": { "$ref": "#/$defs/positive_integer" },
        "wall_milliseconds": { "$ref": "#/$defs/positive_integer" },
        "memory_bytes": { "$ref": "#/$defs/positive_integer" },
        "storage_bytes": { "$ref": "#/$defs/positive_integer" },
        "processes": { "$ref": "#/$defs/positive_integer" },
        "network_bytes": { "$ref": "#/$defs/nonnegative_integer" },
        "evaluator_queries": { "$ref": "#/$defs/positive_integer" },
        "model_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "money_microusd": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "epoch_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "cpu_milliseconds",
        "wall_milliseconds",
        "memory_bytes",
        "storage_bytes",
        "processes",
        "network_bytes",
        "evaluator_queries",
        "model_tokens",
        "money_microusd"
      ],
      "properties": {
        "candidates": { "$ref": "#/$defs/positive_integer" },
        "cpu_milliseconds": { "$ref": "#/$defs/positive_integer" },
        "wall_milliseconds": { "$ref": "#/$defs/positive_integer" },
        "memory_bytes": { "$ref": "#/$defs/positive_integer" },
        "storage_bytes": { "$ref": "#/$defs/positive_integer" },
        "processes": { "$ref": "#/$defs/positive_integer" },
        "network_bytes": { "$ref": "#/$defs/nonnegative_integer" },
        "evaluator_queries": { "$ref": "#/$defs/positive_integer" },
        "model_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "money_microusd": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_candidate", "per_epoch"],
      "properties": {
        "per_candidate": { "$ref": "#/$defs/candidate_budget" },
        "per_epoch": { "$ref": "#/$defs/epoch_budget" }
      }
    }
  },
  "$comment": "Cross-field rules (profile ceilings, mutation level/kind, failure action by evidence class, protected evidence access, and budget consistency) are enforced by laicode.contracts. JSON floats and non-NFC strings are rejected by the canonical decoder."
}
