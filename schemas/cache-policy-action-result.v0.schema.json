{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laicode.dev/schemas/cache-policy-action-result.v0.schema.json",
  "title": "LAIcode cache-policy action result v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "accepted",
    "action_id",
    "type_and_effect_delta",
    "open_holes",
    "proof_obligations",
    "structured_diagnostics",
    "action_cost"
  ],
  "properties": {
    "schema_version": { "const": "CachePolicyActionResultV0" },
    "state_id": { "$ref": "#/$defs/content_id" },
    "accepted": { "type": "boolean" },
    "action_id": {
      "oneOf": [
        { "$ref": "#/$defs/content_id" },
        { "type": "null" }
      ]
    },
    "type_and_effect_delta": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["filled_hole", "produced_type", "added_effects"],
          "properties": {
            "filled_hole": { "const": "root" },
            "produced_type": { "const": "CacheKeyV0" },
            "added_effects": { "type": "array", "maxItems": 0 }
          }
        },
        { "type": "null" }
      ]
    },
    "open_holes": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/hole" }
    },
    "proof_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "structured_diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "action_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_steps"],
      "properties": {
        "semantic_steps": { "const": 1 }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "hole_id",
        "expected_type",
        "allowed_effects",
        "scope",
        "obligations"
      ],
      "properties": {
        "node": { "const": "hole" },
        "hole_id": { "const": "root" },
        "expected_type": { "const": "CacheKeyV0" },
        "allowed_effects": { "type": "array", "maxItems": 0 },
        "scope": {
          "type": "array",
          "prefixItems": [{ "const": "snapshot" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "obligations": {
          "type": "array",
          "prefixItems": [
            { "const": "result_is_evictable" },
            { "const": "result_is_not_pinned" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["invalid_action_transport", "action_rejected"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
